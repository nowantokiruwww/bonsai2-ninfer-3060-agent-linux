# ---------------------------------------------------------------------------
# config/release.env —— 发布物与模型的下载地址
#
# ⚠ 唯一需要你按自己账号改的地方：把 OWNER 换成你的 GitHub 用户名。
#   （仓库里不含 2.6 GB 的引擎载荷和 9.5 GB 的权重，它们放在 Release 附件里）
# ---------------------------------------------------------------------------

# 仓库标识
REPO_OWNER="${REPO_OWNER:-nowantokiruwww}"
REPO_NAME="${REPO_NAME:-bonsai2-ninfer-3060-agent-linux}"
REPO_VERSION="${REPO_VERSION:-0.1.0}"

# 引擎载荷（3 个二进制 + 4 个 CUDA 运行库 + 标定 profile + agent 脚本）
RELEASE_BASE="${RELEASE_BASE:-https://github.com/${REPO_OWNER}/${REPO_NAME}/releases/download/v${REPO_VERSION}}"
RUNTIME_ASSET="${RUNTIME_ASSET:-runtime-${REPO_VERSION}-linux-x86_64.tar.zst}"

# 模型（9.5 GB）
MODEL_ENDPOINT="${MODEL_ENDPOINT:-https://hf-mirror.com}"
MODEL_REPO="${MODEL_REPO:-WaveCut/Ternary-Bonsai-2-27B-NInfer-v3}"
MODEL_REVISION="${MODEL_REVISION:-b85b33627b27b9757a5a094fc74785a53e99f8ee}"
MODEL_FILENAME="${MODEL_FILENAME:-Ternary-Bonsai-2-27B-ninfer-v3.ninfer}"
MODEL_SHA256="${MODEL_SHA256:-cdc4810b0ff17c40d0f62cf214b6e0bcd08346e9eb05ca53371507037793c14a}"
MODEL_BYTES="${MODEL_BYTES:-9520051456}"
