#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# presets.env —— 预设档位
#
# 全部来自在 RTX 3060 上的实测（见 docs/PARAMETERS.md 与 docs/params/）：
#
#   balanced  生产默认。思考开、预算 1024、V100 采样。
#             固定任务墙钟 44.2 s，3/3 真正写出文件。← 就是 3060 上正在跑的
#   fast      关思考。代码/工具类请求最快（65–88 tok/s）。
#             ⚠ 中文散文反而更慢（~26 vs 39–58），因为英文推理文本的
#               投机接受率比中文散文高。
#   think     预算 4096。墙钟 67.8 s，3 次里只有 1 次真正写完文件。
#   deep      预算 8192 + effort high。最慢，留给"宁可慢也要想清楚"的场合。
#   greedy    ⚠ 危险，仅用于复现问题。--greedy 会强制 temperature 0，
#             配合任何关闭思考的配置会让模型把同一条工具调用逐字节重复
#             43 次且永不自愈（病历 L26）。生产配置绝不加它。
#
# 一条硬约束（实测）：**思考预算 + 工具调用载荷(≈6,100 tok) ≤ max_tokens**
#   预算 1024 + max_tokens 900 → 三条全部 finish_reason=length、content 0 字符。
# ---------------------------------------------------------------------------

PRESET_NAMES="balanced fast think deep greedy"

preset_apply() {
  local name="$1"
  P_THINKING=on; P_EFFORT="medium"; P_BUDGET="1024"; P_SAMPLE="v100"; P_DESC=""
  case "$name" in
    balanced|"")
      P_DESC="生产默认：思考开 + 预算 1024 + V100 采样（3060 正在跑的）" ;;
    fast)
      P_THINKING=off; P_EFFORT=""; P_BUDGET=""
      P_DESC="关思考：代码/工具最快，中文散文反而更慢" ;;
    think)
      P_BUDGET="4096"
      P_DESC="思考预算 4096：更慢、产出未必更好" ;;
    deep)
      P_BUDGET="8192"; P_EFFORT="high"
      P_DESC="预算 8192 + effort high：最慢" ;;
    greedy)
      P_SAMPLE="greedy"
      P_DESC="危险：--greedy 强制 argmax，会诱发逐字节复读锁死（L26）" ;;
    *)
      echo "[fail] 未知预设 '$name'（可选：$PRESET_NAMES）" >&2
      return 1 ;;
  esac
  PRESET="$name"
  return 0
}

# 采样参数 → flag 串
sampling_flags() {
  case "${P_SAMPLE:-v100}" in
    v100)   printf '%s' "--temperature 1.0 --top-p 0.95 --top-k 20" ;;
    greedy) printf '%s' "--greedy" ;;
    none)   printf '%s' "" ;;
    *)      echo "[fail] 未知采样档 '${P_SAMPLE}'" >&2; return 1 ;;
  esac
}

# 思考参数 → flag 串
#
# ⚠ --no-thinking 与 --default-reasoning-effort 互斥，
#   服务端会 throw（src/serve/serve_options.cpp）。所以关思考时两个都不传。
thinking_flags() {
  if [ "${P_THINKING:-on}" = "off" ]; then
    printf '%s' "--no-thinking"
    return 0
  fi
  local out=""
  [ -n "${P_EFFORT:-}" ] && out="--default-reasoning-effort $P_EFFORT"
  [ -n "${P_BUDGET:-}" ] && out="$out --default-thinking-budget $P_BUDGET"
  printf '%s' "${out# }"
}

preset_table() {
  local n
  for n in $PRESET_NAMES; do
    preset_apply "$n" >/dev/null 2>&1 || continue
    printf '  %-9s %s\n' "$n" "$P_DESC"
  done
}
